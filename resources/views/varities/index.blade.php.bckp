<script>
    $(document).ready(function() {
        $(".table").DataTable({
            ordering: false
        })

        $(".btn-outline-warning").click(function(e){

            swal(
                {
                    title: "Se eliminaran un total de {{$delete_final_boss}} variedades",
                    // text:", los que caeran en la papelera.",
                    type:"warning",
                    showCancelButton:!0,
                    confirmButtonText:"Si, enviar a papelera",
                    cancelButtonText:"No, cancelar",
                    reverseButtons:!0
                }
            ).then(function(e){
                if(e.value){
                   $.ajax({
                        url: '/delete_final_boss',
                        type: 'get',
                        dataType: 'json',
                        // data: {id: id}
                    }).done(function(data) {
                        Swal({
                          title: 'Variedades eliminadas correctamente.',
                          text: "",
                          type: 'success',
                          showCancelButton: false,
                          showConfirmButton: false,
                        })
                    })
                }else{
                    return false;
                }
            })
            return false;
        })

        $(".btn-outline-danger").click(function(e){

            e.preventDefault()
            var element = $(this)
            id = $(element).attr('attr-id')
            
            $.ajax({
                url: '/varity/check_to_delete',
                type: 'get',
                dataType: 'json',
                data: {id: id}
            }).done(function(data) {
                if(data.status){
                    swal(
                        {
                            title: data.msj,
                            text:"Si elimina el registro este desaparecera del sistema pero quedara en papelera.",
                            type:"warning",
                            showCancelButton:!0,
                            confirmButtonText:"Si, enviar a papelera",
                            cancelButtonText:"No, continuar",
                            reverseButtons:!0
                        }
                    ).then(function(e){
                        if(e.value){
                           $(element).parent().submit()
                        }else{
                            return false;
                        }
                    })
                    return false;
                }else{
                    swal(
                        {
                            title: data.msj,
                            text:"Si elimina el registro este desaparecera del sistema",
                            type:"warning",
                            showCancelButton:!0,
                            confirmButtonText:"Si, eliminar",
                            cancelButtonText:"No, continuar",
                            reverseButtons:!0
                        }
                    ).then(function(e){
                        if(e.value){
                           $(element).parent().submit()
                        }else{
                            return false;
                        }
                    })
                    return false;
                }
            })
        })
    });
</script>
@endsection
