                                    @$check_mother_steril->steril_mom == 0 ? $check_mother_steril = "Sin Berries":"";
                                    @$check_mother_steril->steril_mom == 1 ? $check_mother_steril = "Normal":"";
                                    @$check_mother_steril->steril_mom == 2 ? $check_mother_steril = "Alto":"";
