	                </thead>
	                <tbody>
	                    @if(!empty($vs_p2) && @$vs_p2[0]->player2 != null)
	                        @foreach($vs_p2 as $key => $p2)
	                        	@php $p2 = (array)$p2; @endphp
	                        	<tr>
	                                <td>{{ @$p2['player1'] }}</td>
	                                <td>{{ @$p2['player2'] }}</td>
	                                <td>{{ @$p2['team1'] }}</td>
	                                <td>{{ @$p2['team2'] }}</td>
	                                <td>{{ @$p2['fecha'] }}</td>
	                                <td>{{ @$p2['hora'] }}</td>
	                                <td>{{ @$p2['ht1'] }}</td>
	                                <td>{{ @$p2['ht2'] }}</td>
	                                <td>{{ (@$p2['ht1'] + @$p2['ht2']) }}</td>
	                                <td>{{ @$p2['ft1'] }}</td>
	                                <td>{{ @$p2['ft2'] }}</td>
	                                <td>{{ (@$p2['ft1'] + @$p2['ft2']) }}</td>
	                                <td>{{ ((@$p2['ft1'] + @$p2['ft2']) - (@$p2['ht1'] + @$p2['ht2'])) }}</td>
