{{-- === Controles de Resumen (markets + botón) === --}}
<div class="container my-3">
  <div class="row align-items-end">
    <div class="col-md-8">
      <label for="summaryMarkets" class="mb-1">Mercados (FT Over x.5)</label>
      <select id="summaryMarkets" class="form-control" multiple>
        <option value="0.5">0.5</option>
        <option value="1.5">1.5</option>
        <option value="2.5" selected>2.5</option>
        <option value="3.5" selected>3.5</option>
        <option value="4.5" selected>4.5</option>
        <option value="5.5">5.5</option>
        <option value="6.5">6.5</option>
      </select>
      <small class="text-muted">Mantén CTRL / CMD para seleccionar varios.</small>
    </div>
    <div class="col-md-4">
      <button id="btnSummary" class="btn btn-success btn-block mt-3">
        Ver resumen (HT / Global)
      </button>
    </div>
  </div>
</div>

{{-- === Modal de Resumen === --}}
<div class="modal fade" id="summaryModal" tabindex="-1" role="dialog" aria-labelledby="summaryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl" role="document" style="        max-width: 1200px!important;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          Resumen de mercados — <span id="summaryTitlePlayers">{{ $player1 }} vs {{ $player2 }}</span>
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        {{-- Recomendación rápida --}}
        <div class="card mb-3">
          <div class="card-body">
            <div id="summaryReco" class="d-flex flex-wrap align-items-center">
              <div class="mr-3">
                <strong>Recomendación:</strong>
                <span id="recoText">—</span>
              </div>
              <div class="ml-auto">
                <span id="recoBadge" class="badge badge-info">—</span>
              </div>
            </div>
          </div>
        </div>

        {{-- Tabla por mercado y ventana --}}
        <div class="table-responsive">
          <table class="table table-sm table-bordered">
            <thead class="thead-light">
			  <tr>
			    <th>Mercado</th>
			    <th>Ventana</th>
			    <th>Partidos (HT)</th>
			    <th>Partidos (Global)</th>
			    <th>% Over (HT)</th>
			    <th>% Over (Global)</th>
			    <th>% Under (HT)</th>
			    <th>% Under (Global)</th>
			    <th>Gap Over (abs)</th>
			    <th>Validez</th>
			  </tr>
			</thead>

            <tbody id="summaryTbody">
              <tr><td colspan="9" class="text-center text-muted">Sin datos aún</td></tr>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
$(document).ready(function(){
    $('.show-detail').click(function(e){
        e.preventDefault();
        var period = $(this).data('period');
        var playerType = $(this).data('player'); // 'p1', 'p2' o 'global'
        player1 = $(this).data('player1');
        player2 = $(this).data('player2');
        ht1 = $(this).data('ht1');
        ht2 = $(this).data('ht2');
        var url = $(this).data('url');

        $.ajax({
            url: url,
            type: 'GET',
            data: {
                period: period,
                player: playerType,
                player1: player1,
                player2: player2,
                ht1: ht1,
                ht2: ht2
            },
            success: function(response) {
                $('#modalDetailContent').html(response);
                $('#detailModal').modal('show');
            },
            error: function() {
                $('#modalDetailContent').html('<p>Error al cargar los detalles.</p>');
                $('#detailModal').modal('show');
            }
        });
    });

    $(".filter").click(function(){
    	data = {
    		market : $(this).attr('attr-val'),
			team1 : $("#team1 option:selected").text(),
			team2 : $("#team2 option:selected").text(),
	    	ht1 : $("#ht1").val(),
			ht2 : $("#ht2").val(),
			player1: @json($player1),
			player2: @json($player2)
    	}

    	$.ajax({
            url: "bets/shiny_data",
            type: 'GET',
            data: data,
            success: function(response) {
                // Nombres de los equipos
		      $('#teamAName').text(response.teamA);
		      $('#teamBName').text(response.teamB);

		      // Últimos 5 partidos Team A
		      const $last5A = $('#last5A').empty();
		      response.last5A.forEach(m => {
		        const htt    = m.ht1 + m.ht2;
		        const ft_tot = m.ft_total; // viene de tu selectRaw (ft1+ft2)
		        $last5A.append(`
		          <tr>
		            <td>${m.player1}</td>
		            <td>${m.team1}</td>
		            <td>${m.player2}</td>
		            <td>${m.team2}</td>
		            <td>${m.ht1}</td>
		            <td>${m.ht2}</td>
		            <td>${htt}</td>
		            <td>${m.ft1}</td>
		            <td>${m.ft2}</td>
		            <td>${ft_tot}</td>
		            <td>${m.sp}</td>
		          </tr>
		        `);
		      });

		      // Últimos 5 partidos Team B
		      const $last5B = $('#last5B').empty();
		      response.last5B.forEach(m => {
		        const htt    = m.ht1 + m.ht2;
		        const ft_tot = m.ft_total;
		        $last5B.append(`
		          <tr>
		            <td>${m.player1}</td>
		            <td>${m.team1}</td>
		            <td>${m.player2}</td>
		            <td>${m.team2}</td>
		            <td>${htt}</td>
		            <td>${m.ft1}</td>
		            <td>${m.ft2}</td>
		            <td>${ft_tot}</td>
		            <td>${m.sp}</td>
		          </tr>
		        `);
		      });

      	const rows = [
		  { label: "Hoy",       data: response.today_data },
		  { label: "3D",        data: response.three_data },
		  { label: "7D",        data: response.week_data },
		  { label: "14D",       data: response.two_week_data },
		  { label: "30D",       data: response.month_data },
		  { label: "Global",    data: response.all_data }
		];

		// Generar el HTML del tbody
		let tbodyHtml = '';
		rows.forEach(row => {
		  tbodyHtml += `<tr>
		    <td>${row.label}</td>
		    <td>${row.data.matches_filtered ?? '-'}</td>
		    <td>${row.data.matches_global ?? '-'}</td>
		    <td>${row.data.zero_filtered ?? '-'}</td>
		    <td>${row.data.zero_global ?? '-'}</td>
		    <td>${row.data.one_filtered ?? '-'}</td>
		    <td>${row.data.one_global ?? '-'}</td>
		    <td>${row.data.two_filtered ?? '-'}</td>
		    <td>${row.data.two_global ?? '-'}</td>
		    <td>${row.data.tree_filtered ?? '-'}</td>
		    <td>${row.data.tree_global ?? '-'}</td>
		    <td>${row.data.four_filtered ?? '-'}</td>
		    <td>${row.data.four_global ?? '-'}</td>
		    <td>${row.data.market_over_filtered ?? '-'}</td>
		    <td>${row.data.market_over_global ?? '-'}</td>
		    <td>${row.data.market_under_filtered ?? '-'}</td>
		    <td>${row.data.market_under_global ?? '-'}</td>
		  </tr>`;
		});

// Insertar en el tbody de la tabla
$('table.table-sm.table-bordered tbody').html(tbodyHtml);

		      // Mostrar modal
		      $('#statsModal').modal('show');
            },
            error: function() {
                $('#modalDetailContent').html('<p>Error al cargar los detalles.</p>');
                $('#detailModal').modal('show');
            }
        });
    	
    })

});
</script>
<script type="text/javascript">
        $(document).ready(function() {
        	$(".dttable").DataTable({
        		scrollX: true,
        		paginate: false,
        		info: false
        	})
        })
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    let player1 = @json($player1);
    let player2 = @json($player2);
    document.title = `${player1} vs ${player2} | Comparar`;
});
</script>
<script>
(function(){
  // Helpers
  function getSelectedMarkets(){
    return Array.from(document.querySelectorAll('#summaryMarkets option:checked')).map(o => o.value);
  }

  function td(v){ return `<td>${(v ?? '-') }</td>`; }

function classForGap(g){
  if (g >= 15) return 'badge badge-success';
  if (g >= 8)  return 'badge badge-warning';
  return 'badge badge-secondary';
}
function sampleBadgeHT(n){
  if (n == null) return '';
  if (n < 8) return ' <span class="badge badge-danger">muestra baja</span>';
  if (n < 12) return ' <span class="badge badge-warning">muestra media</span>';
  return '';
}
function windowLabel(key){
  return ({today:'Hoy', '3d':'3D', '7d':'7D', '14d':'14D', '30d':'30D', 'all':'Global'})[key] || key;
}

function renderSummary(response){
  // Recomendación
  const reco = response.recommendation || null;
  if (reco && reco.market) {
    const dirTxt = reco.direction ? (reco.direction.toUpperCase()) : '';
    $('#recoText').text(`Mayor separación en ${reco.market} durante ${windowLabel(reco.window)} — GAP ${reco.gap} ${dirTxt ? `(${dirTxt})` : ''}`);
    $('#recoBadge').text(`z=${(reco.details?.zscore ?? '-')}`);
    $('#recoBadge').removeClass('badge-info badge-secondary').addClass('badge-info');
  } else {
    $('#recoText').text('Sin señal válida — muestras insuficientes o GAP bajo');
    $('#recoBadge').text('—');
    $('#recoBadge').removeClass('badge-info').addClass('badge-secondary');
  }

  // Tabla de filas
  const markets = response.markets || [];
  const results = response.results || {};
  const order   = ['today','3d','7d','14d','30d','all'];

  let rows = '';
  markets.forEach(mkt => {
    const mData = results[mkt] || {};
    order.forEach(w => {
      const d = mData[w] || {};
      const valid = d.valid ? '✅' : '❌';
      const why   = d.why_invalid || {};
      const tips  = d.valid
        ? ''
        : `title="Req: ${why.abs?'✓abs':'✗abs'}, ${why.prop?'✓prop':'✗prop'}, ${why.gap?'✓gap':'✗gap'}, ${why.z?'✓z':'✗z'}"`;

      rows += `<tr>
        <td>${mkt}</td>
        <td>${windowLabel(w)}</td>
        <td>${(d.matches_filtered ?? '-')}${sampleBadgeHT(d.matches_filtered)}</td>
        <td>${d.matches_global ?? '-'}</td>
        <td>${d.over_filtered ?? '-'}</td>
        <td>${d.over_global ?? '-'}</td>
        <td>${d.under_filtered ?? '-'}</td>
        <td>${d.under_global ?? '-'}</td>
        <td><span class="${classForGap(d.gap_over_abs ?? 0)}">${d.gap_over_abs ?? '-'}</span></td>
        <td ${tips}>${valid} ${d.direction ? `<span class="badge badge-light">${d.direction}</span>` : ''} ${d.zscore ? `<span class="badge badge-info">z=${d.zscore}</span>` : ''}</td>
      </tr>`;
    });
  });

  if(!rows){
    rows = `<tr><td colspan="10" class="text-center text-muted">No hubo resultados</td></tr>`;
  }

  $('#summaryTbody').html(rows);
}


  // Click: botón resumen
  $('#btnSummary').on('click', function(e){
    e.preventDefault();

    const params = {
      player1: @json($player1),
      player2: @json($player2),
      ht1: $('#ht1').val(),
      ht2: $('#ht2').val(),
      markets: getSelectedMarkets()
    };

    $.ajax({
      url: "{{ url('/bets/summary') }}",
      type: 'GET',
      data: params,
      beforeSend: function(){
        $('#summaryTbody').html(`<tr><td colspan="9" class="text-center">Cargando...</td></tr>`);
        $('#recoText').text('Calculando…');
        $('#recoBadge').text('—');
        $('#summaryModal').modal('show');
      },
      success: function(resp){
        renderSummary(resp || {});
      },
      error: function(xhr){
        $('#summaryTbody').html(`<tr><td colspan="9" class="text-center text-danger">Error al consultar el resumen</td></tr>`);
        $('#recoText').text('—');
        $('#recoBadge').text('—');
      }
    });
  });
})();
</script>


@include('bets.stats_modal')
@endsection
